{
  "name": "ExamAttempt",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "total": {
      "type": "integer"
    },
    "passed": {
      "type": "boolean"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}